{
  "manifest_version": 3,
  "name": "Download Manager Entegrasyonu",
  "version": "2.1.0",
  "description": "Tarayıcı indirmelerini Download Manager uygulamasına gönderir, sayfalardaki video/ses akışlarını yakalar ve videolarda indirme düğmesi gösterir.",
  "key": "",
  "permissions": [
    "downloads",
    "cookies",
    "storage",
    "contextMenus",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "video.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Download Manager",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
